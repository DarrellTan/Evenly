{
  "name": "evenly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Evenly - Free, self-hostable travel expense splitting for friend groups",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=packages/shared run build",
    "build:web": "npm --workspace=apps/web run build",
    "build": "npm run build:shared && npm run build:web",
    "web:dev": "npm run build:shared && npm --workspace=apps/web run dev",
    "mobile:start": "npm --workspace=apps/mobile start",
    "test": "npm --workspace=packages/shared test",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset"
  },
  "keywords": [
    "expense-splitter",
    "travel",
    "splitwise-alternative",
    "self-hosted",
    "nextjs",
    "supabase",
    "react-native",
    "expo"
  ],
  "author": "Darrell Tan",
  "license": "MIT",
  "overrides": {
    "postcss": "^8.5.28"
  }
}
